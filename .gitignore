cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
venv/
.venv/

# Pytest
.pytest_cache/

# Environment variables / secrets
.env
.env.*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage
.coverage
htmlcov/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local database / temporary files
*.sqlite
*.db
EOF
